  <style>
    /* Base & Custom Scrollbar */
    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: radial-gradient(circle at 15% 15%, #064e3b 0%, #022c22 48%, #011813 100%);
      color: #f8fafc;
      min-height: 100vh;
      overflow-x: hidden;
      font-family: 'Inter', sans-serif;
    }

    /* Ambient Animated Orbs */
    .ambient-orb {
      position: fixed;
      border-radius: 9999px;
      filter: blur(80px);
      z-index: 0;
      pointer-events: none;
      opacity: 0.45;
      animation: floatOrb 14s ease-in-out infinite alternate;
    }

    .orb-1 {
      width: 340px;
      height: 340px;
      background: #10b981;
      top: -80px;
      left: -80px;
    }

    .orb-2 {
      width: 400px;
      height: 400px;
      background: #047857;
      bottom: -100px;
      right: -100px;
      animation-delay: -5s;
    }

    .orb-3 {
      width: 260px;
      height: 260px;
      background: #34d399;
      top: 45%;
      left: 55%;
      opacity: 0.2;
      animation-duration: 18s;
    }

    @keyframes floatOrb {
      0% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(25px, -30px) scale(1.08); }
      100% { transform: translate(-20px, 20px) scale(0.95); }
    }

    /* Glassmorphism Cards with High Contrast Readability */
    .glass-panel {
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.13) 0%, rgba(255, 255, 255, 0.05) 100%);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.22);
      box-shadow: 0 20px 45px -15px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.25);
    }

    .glass-card {
      background: rgba(2, 44, 34, 0.62);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(255, 255, 255, 0.18);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
      transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
                  border-color 0.3s ease,
                  background-color 0.3s ease,
                  box-shadow 0.3s ease;
    }

    .glass-card:hover, .glass-card:active {
      transform: translateY(-3px) scale(1.01);
      border-color: rgba(52, 211, 153, 0.65);
      background: rgba(6, 78, 59, 0.72);
      box-shadow: 0 12px 28px rgba(16, 185, 129, 0.22);
    }

    .glass-white-tint {
      background: rgba(255, 255, 255, 0.11);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.24);
    }

    /* Profile Photo Glow & Floating */
    .profile-ring {
      position: relative;
      animation: profileFloat 5s ease-in-out infinite;
    }

    .profile-ring::before {
      content: '';
      position: absolute;
      inset: -6px;
      border-radius: 9999px;
      background: conic-gradient(from 0deg, #34d399, #ffffff, #10b981, #064e3b, #34d399);
      animation: spinSlow 8s linear infinite;
      z-index: -1;
      opacity: 0.9;
    }

    @keyframes profileFloat {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-7px); }
    }

    @keyframes spinSlow {
      to { transform: rotate(360deg); }
    }

    /* Page Transition & Staggered Item Animations */
    .page-section {
      display: none;
      opacity: 0;
    }

    .page-section.active {
      display: block;
      animation: pageFadeIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes pageFadeIn {
      from {
        opacity: 0;
        transform: translateY(14px) scale(0.985);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    /* Staggered Point Animations */
    .anim-item {
      opacity: 0;
      transform: translateY(20px);
    }

    .page-section.active .anim-item {
      animation: staggerSlideUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: calc(var(--i, 0) * 85ms);
    }

    .page-section.active .anim-pop {
      animation: staggerPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
      animation-delay: calc(var(--i, 0) * 85ms);
    }

    @keyframes staggerSlideUp {
      from {
        opacity: 0;
        transform: translateY(22px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes staggerPop {
      from {
        opacity: 0;
        transform: scale(0.88) translateY(14px);
      }
      to {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }

    /* Touch Ripple Effect */
    .touch-ripple {
      position: relative;
      overflow: hidden;
    }

    .ripple-circle {
      position: absolute;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.35);
      transform: scale(0);
      animation: rippleAnim 0.6s linear;
      pointer-events: none;
    }

    @keyframes rippleAnim {
      to {
        transform: scale(4);
        opacity: 0;
      }
    }

    /* Navigation Active State */
    .nav-btn.active {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #ffffff;
      border-color: rgba(255, 255, 255, 0.45);
      box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
    }

    /* Custom Scrollbar for inner readability */
    ::-webkit-scrollbar {
      width: 6px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(2, 44, 34, 0.4);
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(52, 211, 153, 0.4);
      border-radius: 9999px;
    }
  </style>
</head>
